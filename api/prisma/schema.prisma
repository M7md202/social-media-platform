// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User and Authentication
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  password          String
  firstName         String?
  lastName          String?
  avatar            String?
  bio               String?
  language          String    @default("en")
  timezone          String    @default("UTC")
  emailVerified     Boolean   @default(false)
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  status            String    @default("active") // active, suspended, deleted
  role              String    @default("user") // user, admin
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  workspaces        Workspace[]
  sessions          Session[]
  tokens            Token[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
}

model Token {
  id        String   @id @default(cuid())
  token     String   @unique
  type      String   // refresh, reset, verify
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Workspace and Organization
model Workspace {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logo          String?
  description   String?
  currency      String   @default("USD")
  timezone      String   @default("UTC")
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  members       WorkspaceMember[]
  brands        Brand[]
  socialAccounts SocialAccount[]
  campaigns     Campaign[]
  posts         Post[]
  analytics     Analytics[]
  leads         Lead[]
  automations   Automation[]
  mediaLibrary  MediaLibraryItem[]
  templates     Template[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  role        String   @default("member") // owner, admin, member, viewer
  permissions String[] @default([])
  joinedAt    DateTime @default(now())

  @@unique([workspaceId, userId])
}

model Brand {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  logo          String?
  website       String?
  industry      String?
  voiceGuidelines String?
  targetAudience String?
  products      String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  socialAccounts SocialAccount[]
  campaigns     Campaign[]
  leads         Lead[]
}

// Social Media Accounts
model SocialAccount {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandId         String?
  brand           Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  platform        String   // facebook, instagram, twitter, linkedin, youtube, tiktok, telegram, whatsapp, pinterest
  platformId      String   // Platform-specific ID
  username        String
  displayName     String?
  avatar          String?
  bio             String?
  followers       Int      @default(0)
  following       Int      @default(0)
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime?
  scope           String[] @default([])
  isConnected     Boolean  @default(true)
  connectedAt     DateTime @default(now())
  lastSync        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  posts           Post[]
  analytics       Analytics[]
  automations     Automation[]
  messages        Message[]

  @@unique([workspaceId, platform, platformId])
}

// Content and Posts
model Post {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  
  title           String?
  content         String
  status          String   @default("draft") // draft, scheduled, published, failed
  scheduledAt     DateTime?
  publishedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  
  // Content Details
  captions        String[]
  hashtags        String[]
  mentions        String[]
  media           MediaItem[]
  links           String[]
  platformSettings Json? // Platform-specific settings
  
  // Analytics
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  saves           Int      @default(0)
  views           Int      @default(0)
  clicks          Int      @default(0)
  reach           Int      @default(0)
  impressions     Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  templateId      String?
  template        Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  insights        PostInsight[]
  comments        Comment[]
}

model MediaItem {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  type      String   // image, video, document, link
  duration  Int?     // for videos
  size      Int?
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  text      String
  author    String
  authorAvatar String?
  likes     Int      @default(0)
  createdAt DateTime @default(now())
}

model Template {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  category      String   // promotional, engagement, educational, etc
  content       String
  platforms     String[] // which platforms this template is for
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  posts         Post[]
}

model MediaLibraryItem {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  type          String   // image, video, document
  url           String
  size          Int
  duration      Int?     // for videos
  thumbnail     String?
  tags          String[]
  folder        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Campaigns
model Campaign {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  objective     String   // awareness, engagement, conversions, leads
  status        String   @default("planning") // planning, scheduled, active, paused, completed
  platforms     String[] // which platforms
  startDate     DateTime
  endDate       DateTime
  budget        Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  posts         Post[]
  analytics     Analytics[]
  leads         Lead[]
}

model PostInsight {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  likes     Int
  comments  Int
  shares    Int
  views     Int
  clicks    Int
  reach     Int
  impressions Int
}

model Analytics {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  
  date            DateTime @default(now())
  followers       Int      @default(0)
  following       Int      @default(0)
  engagement      Float    @default(0)
  reach           Int      @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  conversions     Int      @default(0)
  revenue         Float    @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Automation and Workflows
model Automation {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  
  name            String
  description     String?
  type            String   // scheduled, recurring, trigger-based, rss
  status          String   @default("active") // active, paused, inactive
  workflow        Json     // Workflow configuration with nodes
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  executions      AutomationExecution[]
}

model AutomationExecution {
  id            String   @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  
  status        String   @default("pending") // pending, running, success, failed
  result        Json?
  error         String?
  executedAt    DateTime?
  createdAt     DateTime @default(now())
}

// Messages and Inbox
model Message {
  id              String   @id @default(cuid())
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  
  conversationId  String
  senderId        String
  senderName      String
  senderAvatar    String?
  text            String
  attachments     String[]
  
  status          String   @default("unread") // unread, read, archived
  labels          String[]
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([conversationId])
  @@index([socialAccountId])
}

// Leads and CRM
model Lead {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandId       String?
  brand         Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  
  firstName     String
  lastName      String?
  email         String?
  phone         String?
  company       String?
  position      String?
  
  source        String   // social, website, form, import, manual
  status        String   @default("new") // new, contacted, qualified, converted, lost
  pipeline      String   @default("default")
  tags          String[]
  customFields  Json?
  notes         String?
  
  lastContacted DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([workspaceId])
  @@index([email])
}

// Notifications
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String   // post_published, post_failed, analytics, automation, lead
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([createdAt])
}

// Activity Log
model ActivityLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  action        String   // created, updated, deleted, published, etc
  entityType    String   // post, campaign, automation, etc
  entityId      String
  description   String?
  changes       Json?
  ipAddress     String?
  userAgent     String?
  
  createdAt     DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
}
